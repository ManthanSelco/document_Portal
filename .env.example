# Copy to .env for local testing with `npx vercel dev`.
# On Vercel, add these under Project → Settings → Environment Variables instead.
# Never add a VITE_ or NEXT_PUBLIC_ prefix — these must stay server-side.



AWS_REGION=eu-north-1
AWS_S3_BUCKET_NAME=value-c-1-an

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=


# Optional: max size per file in MB (default 100)
MAX_FILE_MB=100

# Optional: if set, people must enter this passcode to view or upload
PORTAL_PASSCODE=

# Only for testing against a local S3-compatible server. Leave empty for real AWS.
S3_ENDPOINT=
